{
  "name": "app",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.x",
    "yarn": "1.22.x"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets",
    "build:css": "yarn build:webawesome-css && tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify",
    "build:webawesome-css": "esbuild node_modules/@awesome.me/webawesome/dist/styles/webawesome.css --bundle --minify --outfile=app/assets/builds/webawesome.css",
    "design:lint": "designmd lint DESIGN.md",
    "design:build": "node script/build-design-theme.mjs",
    "design:check": "yarn design:lint && node script/build-design-theme.mjs --check"
  },
  "dependencies": {
    "@awesome.me/webawesome": "3.12.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
