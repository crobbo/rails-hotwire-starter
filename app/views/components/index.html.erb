<% content_for :title, "Components · Rails Hotwire Starter" %>

<main class="mx-auto w-full max-w-6xl px-md py-xl sm:px-lg lg:py-xxl">
  <%= render UI::NavbarComponent.new do |navbar| %>
    <% navbar.with_brand do %>
      <%= link_to "Rails Starter", "#overview" %>
    <% end %>
    <% navbar.with_link(label: "Overview", href: "#overview", current: true) %>
    <% navbar.with_link(label: "Foundation", href: "#components") %>
    <% navbar.with_link(label: "Forms", href: "#form-controls") %>
    <% navbar.with_link(label: "All 66", href: "#catalogue") %>
    <% navbar.with_actions do %>
      <%= render UI::MenuComponent.new do |menu| %>
        <% menu.with_trigger(appearance: :outlined, with_caret: true) do %>
          Workspace
        <% end %>
        <% menu.with_label do %>Workspace<% end %>
        <% menu.with_item(label: "Settings", value: "settings", icon_name: "gear", details: "⌘,") %>
        <% menu.with_item(label: "Manage members", value: "members", icon_name: "users") %>
        <% menu.with_item(
          label: "Export",
          value: "export",
          icon_name: "file-export",
          submenu: [
            {label: "CSV spreadsheet", value: "csv"},
            {label: "PDF document", value: "pdf"}
          ]
        ) %>
        <% menu.with_divider %>
        <% menu.with_item(label: "Email notifications", value: "email-notifications", type: :checkbox, checked: true) %>
        <% menu.with_item(label: "Weekly summary", value: "weekly-summary", type: :checkbox) %>
        <% menu.with_divider %>
        <% menu.with_item(label: "Sign out", value: "sign-out", variant: :danger, icon_name: "arrow-right-from-bracket") %>
      <% end %>
    <% end %>
  <% end %>

  <header id="overview" class="flex flex-col gap-lg border-b border-border py-xl md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="mb-sm font-label-sm text-label-sm weight-label-sm leading-label-sm tracking-label-sm text-primary">RAILS HOTWIRE STARTER</p>
      <h1 class="font-headline-lg text-headline-lg weight-headline-lg leading-headline-lg tracking-headline-lg text-text">Quiet Utility</h1>
      <p class="mt-md font-body-lg text-body-lg weight-body-lg leading-body-lg text-text-muted">
        One semantic design source, shared by Tailwind composition and accessible Web Awesome primitives.
      </p>
    </div>

    <div class="flex flex-wrap gap-sm" data-controller="dialog">
      <%= render UI::ButtonComponent.new(variant: :brand, appearance: :accent, data: {action: "click->dialog#open"}) do %>
        Open dialog
      <% end %>

      <%= render UI::DialogComponent.new(
        label: "A shared design system",
        light_dismiss: true,
        class: "design-preview-dialog",
        data: {dialog_target: "dialog"}
      ) do |dialog| %>
        <p class="m-0 font-body-md text-body-md weight-body-md leading-body-md text-text-muted">
          Web Awesome owns focus, keyboard, and dismissal behavior. Rails and Stimulus only orchestrate when it opens.
        </p>

        <% dialog.with_footer do %>
          <%= render UI::ButtonComponent.new(variant: :brand, appearance: :accent, data: {action: "click->dialog#close"}) do %>
            Got it
          <% end %>
        <% end %>
      <% end %>
    </div>
  </header>

  <section id="components" class="grid gap-xl py-xl md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.7fr)] lg:py-xxl" aria-labelledby="foundation-heading">
    <div>
      <p class="mb-sm font-label-sm text-label-sm weight-label-sm leading-label-sm tracking-label-sm text-primary">FOUNDATION</p>
      <h2 id="foundation-heading" class="font-headline-sm text-headline-sm weight-headline-sm leading-headline-sm tracking-headline-sm text-text">Designed to be changed once</h2>
      <p class="mt-md max-w-2xl font-body-md text-body-md weight-body-md leading-body-md text-text-muted">
        Edit <code class="rounded-sm bg-surface-subtle px-xs py-[2px] text-text">DESIGN.md</code>, regenerate the theme, and both layers follow. The starter stays neutral until a product gives it a distinct voice.
      </p>

      <dl class="mt-xl grid gap-md sm:grid-cols-3">
        <div class="border-t border-border pt-md">
          <dt class="font-label-sm text-label-sm weight-label-sm leading-label-sm tracking-label-sm text-text-muted">SOURCE</dt>
          <dd class="mt-xs font-label-lg text-label-lg weight-label-lg leading-label-lg text-text">DESIGN.md</dd>
        </div>
        <div class="border-t border-border pt-md">
          <dt class="font-label-sm text-label-sm weight-label-sm leading-label-sm tracking-label-sm text-text-muted">LAYOUT</dt>
          <dd class="mt-xs font-label-lg text-label-lg weight-label-lg leading-label-lg text-text">Tailwind v4</dd>
        </div>
        <div class="border-t border-border pt-md">
          <dt class="font-label-sm text-label-sm weight-label-sm leading-label-sm tracking-label-sm text-text-muted">BEHAVIOR</dt>
          <dd class="mt-xs font-label-lg text-label-lg weight-label-lg leading-label-lg text-text">Web Awesome · 66</dd>
        </div>
      </dl>
    </div>

    <div class="rounded-lg border border-border bg-surface p-lg">
      <%= render UI::InputComponent.new(
        label: "Project name",
        name: "project[name]",
        hint: "This input inherits the same radius, color, type, and focus tokens.",
        value: "A useful Rails app"
      ) %>
      <div class="mt-lg flex flex-wrap gap-sm">
        <%= render UI::ButtonComponent.new(variant: :brand, appearance: :accent) do %>
          Save project
        <% end %>
        <%= render UI::ButtonComponent.new(appearance: :outlined) do %>
          Cancel
        <% end %>
      </div>
    </div>
  </section>

  <section id="form-controls" class="border-t border-border py-xl lg:py-xxl" aria-labelledby="forms-heading">
    <div class="max-w-2xl">
      <p class="mb-sm font-label-sm text-label-sm weight-label-sm leading-label-sm tracking-label-sm text-primary">FORM CONTROLS</p>
      <h2 id="forms-heading" class="font-headline-sm text-headline-sm weight-headline-sm leading-headline-sm tracking-headline-sm text-text">Rails-friendly, browser-native forms</h2>
      <p class="mt-md font-body-md text-body-md weight-body-md leading-body-md text-text-muted">
        Thin ViewComponent wrappers keep names, values, and validation explicit while Web Awesome owns keyboard and interaction behavior.
      </p>
    </div>

    <div class="mt-xl grid gap-xl rounded-lg border border-border bg-surface p-lg md:grid-cols-2 md:p-xl">
      <div class="grid content-start gap-lg">
        <%= render UI::SelectComponent.new(
          label: "Project visibility",
          name: "project[visibility]",
          hint: "Choose who can find and open this project."
        ) do |select| %>
          <% select.with_option(label: "Private", value: "private", selected: true) %>
          <% select.with_option(label: "Workspace members", value: "workspace") %>
          <% select.with_option(label: "Anyone with the link", value: "link") %>
        <% end %>

        <%= render UI::TextareaComponent.new(
          label: "Project description",
          name: "project[description]",
          value: "A focused place for the team to plan and ship useful work.",
          hint: "A short sentence works best.",
          rows: 4,
          maxlength: 160,
          with_count: true
        ) %>
      </div>

      <div class="grid content-start gap-lg border-t border-border pt-lg md:border-l md:border-t-0 md:pl-xl md:pt-0">
        <div>
          <h3 class="font-label-lg text-label-lg weight-label-lg leading-label-lg text-text">Collaboration</h3>
          <p class="mt-xs font-body-sm text-body-sm weight-body-sm leading-body-sm text-text-muted">Choose how this project communicates with its members.</p>
        </div>

        <%= render UI::CheckboxComponent.new(
          label: "Allow member invitations",
          name: "project[allow_invitations]",
          value: "1",
          hint: "Members can invite other people to this project.",
          checked: true
        ) %>

        <%= render UI::SwitchComponent.new(
          label: "Email activity summaries",
          name: "project[email_summaries]",
          value: "1",
          hint: "Send a concise summary every Friday.",
          checked: true
        ) %>
      </div>
    </div>
  </section>

  <section id="color-modes" class="overflow-hidden rounded-lg border border-border" aria-labelledby="modes-heading">
    <h2 id="modes-heading" class="sr-only">Light and dark color modes</h2>
    <div class="grid md:grid-cols-2">
      <div class="bg-surface p-lg sm:p-xl">
        <p class="font-label-sm text-label-sm weight-label-sm leading-label-sm tracking-label-sm text-text-muted">LIGHT</p>
        <h3 class="mt-sm font-headline-sm text-headline-sm weight-headline-sm leading-headline-sm tracking-headline-sm text-text">Clear, quiet hierarchy</h3>
        <p class="mt-md font-body-md text-body-md weight-body-md leading-body-md text-text-muted">Cool surfaces and restrained borders keep attention on the work.</p>
        <div class="mt-lg flex items-center gap-sm">
          <span class="size-lg rounded-full bg-primary" aria-label="Primary blue"></span>
          <span class="size-lg rounded-full border border-border bg-canvas" aria-label="Canvas"></span>
          <span class="size-lg rounded-full border border-border bg-surface-subtle" aria-label="Subtle surface"></span>
        </div>
      </div>

      <div class="wa-dark bg-surface-dark p-lg sm:p-xl">
        <p class="font-label-sm text-label-sm weight-label-sm leading-label-sm tracking-label-sm text-text-muted-dark">DARK</p>
        <h3 class="mt-sm font-headline-sm text-headline-sm weight-headline-sm leading-headline-sm tracking-headline-sm text-text-dark">The same semantic roles</h3>
        <p class="mt-md font-body-md text-body-md weight-body-md leading-body-md text-text-muted-dark">Dark mode changes surfaces, not the component contract.</p>
        <div class="mt-lg flex flex-wrap gap-sm">
          <%= render UI::ButtonComponent.new(variant: :brand, appearance: :accent) do %>
            Continue
          <% end %>
          <%= render UI::ButtonComponent.new(appearance: :outlined) do %>
            Not now
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%= render "catalogue" %>
</main>
