<% content_for :title, "Components · Rails Hotwire Starter" %>

<main class="mx-auto w-full max-w-6xl px-md py-xl sm:px-lg lg:py-xxl">
  <%= render UI::NavbarComponent.new do |navbar| %>
    <% navbar.with_brand do %>
      <%= link_to "Rails Starter", components_path %>
    <% end %>
    <% navbar.with_actions do %>
      <%= render UI::ButtonComponent.new(
        href: "https://github.com/crobbo/rails-hotwire-starter",
        appearance: :outlined,
        size: :s,
        with_start: true,
        class: "catalogue-github-button",
        target: "_blank",
        rel: "noopener noreferrer"
      ) do %>
        <%= render UI::IconComponent.new(name: "github", family: "brands", slot: "start") %>
        GitHub
      <% end %>
    <% end %>
  <% end %>

  <%= render "catalogue" %>
</main>
