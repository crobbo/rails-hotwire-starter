<section id="catalogue" class="py-xl lg:py-xxl" aria-labelledby="catalogue-heading">
  <div class="catalogue-intro">
    <h1 id="catalogue-heading" class="font-headline-lg text-headline-lg weight-headline-lg leading-headline-lg tracking-headline-lg text-text">Components</h1>
    <p class="mt-md font-body-md text-body-md weight-body-md leading-body-md text-text-muted">
      Browse 50 examples representing 65 supported Web Awesome components in this starter. Rails wrappers appear where they add a useful application API; the remaining primitives are shown directly.
    </p>
  </div>

  <%= render "catalogue_foundations" %>
  <%= render "catalogue_actions" %>
  <%= render "catalogue_forms" %>
  <%= render "catalogue_navigation" %>
  <%= render "catalogue_content" %>
  <%= render "catalogue_utilities" %>

  <footer class="component-catalogue__footer">
    <div>
      <p class="font-label-lg text-label-lg weight-label-lg leading-label-lg text-text">65 supported components are represented in 50 examples.</p>
      <p class="mt-xs font-body-sm text-body-sm weight-body-sm leading-body-sm text-text-muted">All examples are shown above in six categories.</p>
    </div>
    <div class="component-catalogue__footer-links">
      <a href="#catalogue">Back to top</a>
    </div>
  </footer>
</section>
